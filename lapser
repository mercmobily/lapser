    # ==========================================================================
    # MAIN WINDOW SUBSECTION: CAPTURE LIFECYCLE
    # Description: Start and stop screen/window recording, tick active jobs,
    #              capture one annotated frame, and update running status.
    # ==========================================================================

    def start_capture(self, mode: str) -> None:
        paths = self.selected_paths()
        if paths is None:
            return
        if mode == "screen" and not self.dependencies.screen_capture_available:
            self.toast(
                self.unavailable_tooltip(
                    self.dependencies.missing_screen,
                    "Screen capture is unavailable.",
                )
            )
            return
        if mode == "window" and not self.dependencies.window_capture_available:
            self.toast(
                self.unavailable_tooltip(
                    self.dependencies.missing_window,
                    "Window capture is unavailable.",
                )
            )
            return
        if paths.name in self.jobs:
            self.toast("This profile is already recording.")
            return

        label = self.working_entry.get_text()
        write_text_file(paths.label_file, label)

        try:
            if mode == "window":
                self.toast("Choose the target window in the GNOME picker.")
                backend = PortalWindowCapture()
            else:
                backend = FullScreenCapture()
        except PortalCancelled:
            self.toast("Window selection cancelled.")
            return
        except CaptureError as error:
            self.toast(f"Capture could not start: {error}")
            return

        now = time.monotonic()
        job = CaptureJob(
            profile_name=paths.name,
            paths=paths,
            mode=backend.name,
            backend=backend,
            label=label,
            started_at=now,
            last_capture_at=now - CAPTURE_INTERVAL_SECONDS,
        )
        self.jobs[paths.name] = job
        append_log(paths, "START", label)
        job.timer_id = GLib.timeout_add_seconds(1, self.on_job_tick, paths.name)
        self.toast(f"Recording started: {paths.name}")
        self.refresh_profile_rows()
        self.refresh_profile_view()

    def on_job_tick(self, profile_name: str) -> bool:
        job = self.jobs.get(profile_name)
        if job is None:
            return False
        if job.busy:
            return True

        elapsed = time.monotonic() - job.last_capture_at
        if elapsed >= CAPTURE_INTERVAL_SECONDS:
            job.busy = True
            threading.Thread(
                target=self.capture_worker,
                args=(profile_name,),
                daemon=True,
            ).start()
            if self.selected_profile == profile_name:
                self.refresh_profile_view()

        return True

    def capture_worker(self, profile_name: str) -> None:
        job = self.jobs.get(profile_name)
        if job is None:
            return

        try:
            self.capture_one(job)
        except CaptureError as error:
            GLib.idle_add(self.capture_finished, profile_name, False, str(error))
            return

        GLib.idle_add(self.capture_finished, profile_name, True, "")

    def capture_finished(self, profile_name: str, success: bool, error_message: str) -> bool:
        job = self.jobs.get(profile_name)
        if job is None:
            return False

        job.busy = False
        if not success:
            self.stop_job(profile_name, failed=True)
            self.toast(f"{profile_name} stopped: {error_message}")
            return False

        job.shots_taken += 1
        job.last_capture_at = time.monotonic()
        if self.selected_profile == profile_name:
            self.refresh_profile_view()
        else:
            self.refresh_profile_rows()
        return False

    def capture_one(self, job: CaptureJob) -> None:
        now = timestamp()
        raw_path = temp_lapser_path("shot", JPG_SUFFIX)
        final_path = job.paths.shots_current_dir / f"{now}{JPG_SUFFIX}"
        label = read_text_file(job.paths.label_file)

        job.backend.capture(raw_path)
        try:
            result = subprocess.run(
                [
                    COMMAND_IMAGEMAGICK_CONVERT,
                    str(raw_path),
                    "-gravity",
                    "Southwest",
                    "-background",
                    "black",
                    "-fill",
                    "white",
                    "-splice",
                    f"0x{SCREENSHOT_ANNOTATION_HEIGHT}",
                    "-pointsize",
                    str(SCREENSHOT_ANNOTATION_POINT_SIZE),
                    "-annotate",
                    "+0+0",
                    f"{now}: {label}",
                    str(final_path),
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
        except OSError as error:
            raise CaptureError(
                f"Could not run {COMMAND_IMAGEMAGICK_CONVERT}: {error}"
            ) from error
        finally:
            raw_path.unlink(missing_ok=True)

        if result.returncode != 0:
            raise CaptureError(result.stderr.strip() or "Image annotation failed")

    def stop_selected_job(self) -> None:
        if self.selected_profile:
            self.stop_job(self.selected_profile)

    def stop_job(self, profile_name: str, failed: bool = False) -> None:
        job = self.jobs.pop(profile_name, None)
        if job is None:
            return

        if job.timer_id is not None:
            try:
                GLib.source_remove(job.timer_id)
            except GLib.Error:
                pass
        job.backend.close()
        append_log(job.paths, "STOP", job.label)
        if not failed:
            self.toast(f"Recording stopped: {profile_name}")
        self.refresh_profile_rows()
        if self.selected_profile == profile_name:
            self.refresh_profile_view()

    def refresh_running_status(self) -> bool:
        paths = self.selected_paths()
        if paths is not None and paths.name in self.jobs:
            self.refresh_status_controls(paths, len(current_shot_files(paths)))
        return True

