    # ==========================================================================
    # MAIN WINDOW SUBSECTION: DEPENDENCY FEEDBACK
    # Description: Present missing tool information and disable unavailable
    #              feature controls without preventing the app from opening.
    # ==========================================================================

    def update_dependency_banner(self) -> None:
        if not self.dependencies.has_missing:
            self.dependency_banner.set_revealed(False)
            self.dependency_details.set_visible(False)
            return

        self.dependency_banner.set_title("Some Lapser features are unavailable")
        self.dependency_details.set_label(self.dependencies.summary())
        self.dependency_details.set_visible(True)
        self.dependency_banner.set_revealed(True)

    def show_dependency_toast(self) -> bool:
        if self.dependencies.has_missing:
            self.toast(self.dependencies.summary())
        return False

    def unavailable_tooltip(self, missing: Sequence[str], fallback: str) -> str:
        if not missing:
            return fallback
        return f"Install {', '.join(missing)} to enable this."

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: FILESYSTEM ACCESS AND DRAG EXPORT
    # Description: Open profile media folders through the desktop handler and
    #              expose screenshots, converted folders, and videos as file
    #              drags without changing Lapser-owned files.
    # ==========================================================================

    def make_open_folder_button(self, path: Path, tooltip: str) -> Gtk.Button:
        button = labeled_button("folder-symbolic", "Folder", tooltip)
        button.connect("clicked", self.open_folder_for_path, path)
        return button

    def open_current_screenshots_folder(self, _button: Gtk.Button) -> None:
        paths = self.selected_paths()
        if paths is not None:
            self.open_folder(paths.shots_current_dir)

    def open_current_converted_set_folder(self, _button: Gtk.Button) -> None:
        if self.current_converted_set is not None:
            self.open_folder(self.current_converted_set)

    def open_folder_for_path(self, _button: Gtk.Button, path: Path) -> None:
        self.open_folder(path if path.is_dir() else path.parent)

    def open_folder(self, folder: Path) -> None:
        if not folder.exists() or not folder.is_dir():
            self.toast("Folder is missing.")
            return

        uri = Gio.File.new_for_path(str(folder)).get_uri()
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error as error:
            self.toast(f"Could not open folder: {error.message}")

    def add_file_drag_source(self, widget: Gtk.Widget, path: Path) -> None:
        drag_source = Gtk.DragSource()
        drag_source.set_actions(Gdk.DragAction.COPY)
        drag_source.connect("prepare", self.on_file_drag_prepare, path)
        widget.add_controller(drag_source)

    def on_file_drag_prepare(
        self,
        _source: Gtk.DragSource,
        _x: float,
        _y: float,
        path: Path,
    ) -> Gdk.ContentProvider | None:
        if not path.exists():
            self.toast("File or folder is missing.")
            return None

        gfile = Gio.File.new_for_path(str(path))
        uri_bytes = GLib.Bytes.new(f"{gfile.get_uri()}\r\n".encode("utf-8"))
        providers = [
            Gdk.ContentProvider.new_for_value(Gdk.FileList.new_from_list([gfile])),
            Gdk.ContentProvider.new_for_bytes("text/uri-list", uri_bytes),
        ]
        return Gdk.ContentProvider.new_union(providers)

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: PROFILE LIST AND VIEW REFRESH
    # Description: Load profiles, size the sidebar, maintain selection, compute
    #              media signatures, and update visible profile state.
    # ==========================================================================

    def load_profiles(self) -> None:
        ensure_base_dirs()
        self.cleanup_old_staged_deletes()
        clear_container(self.profile_list)
        self.profile_rows.clear()

        profile_dir = DATA_DIR / "profiles"
        profiles = sorted(path.name for path in profile_dir.iterdir() if path.is_dir())
        for profile_name in profiles:
            paths = ProfilePaths.for_name(profile_name)
            paths.ensure()
            row = self.make_profile_row(paths)
            self.profile_rows[profile_name] = row
            self.profile_list.append(row)
        self.resize_sidebar_for_profiles()

    def text_pixel_width(self, text: str, bold: bool = False) -> int:
        layout = self.create_pango_layout(text)
        if bold:
            attributes = Pango.AttrList()
            attributes.insert(Pango.attr_weight_new(Pango.Weight.BOLD))
            layout.set_attributes(attributes)
        width, _height = layout.get_pixel_size()
        return width

    def resize_sidebar_for_profiles(self) -> None:
        header_width = self.text_pixel_width("Profiles", bold=True) + SIDEBAR_HEADER_CHROME_WIDTH
        widest_row = 0
        for row in self.profile_rows.values():
            name = getattr(row, "profile_name", "")
            status = getattr(row, "profile_status", "")
            widest_row = max(
                widest_row,
                self.text_pixel_width(name, bold=True),
                self.text_pixel_width(status),
            )

        width = max(SIDEBAR_MIN_WIDTH, header_width, widest_row + SIDEBAR_ROW_CHROME_WIDTH)
        self.sidebar.set_size_request(width, -1)

    def make_profile_row(self, paths: ProfilePaths) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row.profile_name = paths.name
        row.add_css_class("profile-row")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.set_child(box)

        icon_name = "media-record-symbolic" if paths.name in self.jobs else "folder-symbolic"
        icon = Gtk.Image.new_from_icon_name(icon_name)
        icon.set_pixel_size(15)
        box.append(icon)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text_box.set_hexpand(True)
        box.append(text_box)

        title = Gtk.Label(label=paths.name)
        title.add_css_class("profile-name")
        title.set_halign(Gtk.Align.START)
        title.set_ellipsize(3)
        text_box.append(title)

        shots = len(current_shot_files(paths))
        converted = len(converted_dirs(paths))
        videos = len(video_files(paths.movies_not_uploaded_dir))
        if paths.name in self.converting_profiles:
            status = "Converting"
        elif paths.name in self.jobs:
