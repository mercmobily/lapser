def manual_video_playback_seconds(work_seconds: float) -> float:
    return work_seconds / (VIDEO_FRAMERATE * CAPTURE_INTERVAL_SECONDS)


def manual_card_point_size(sentence: str) -> int:
    length = len(sentence)
    if length <= 60:
        return 42
    if length <= 120:
        return 34
    if length <= 200:
        return 28
    return 24


def has_enough_shots_to_convert(shots: list[Path]) -> bool:
    return len(shots) >= MIN_SHOTS_TO_CONVERT


