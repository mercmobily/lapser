class FullScreenCapture:
    name = "Screen"

    def capture(self, raw_path: Path) -> None:
        previous_animation_setting = self._get_animation_setting()
        self._set_animation_setting("false")
        try:
            try:
                result = subprocess.run(
                    [COMMAND_GNOME_SCREENSHOT, "-f", str(raw_path)],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                    check=False,
                )
            except OSError as error:
                raise CaptureError(
                    f"Could not run {COMMAND_GNOME_SCREENSHOT}: {error}"
                ) from error
            if result.returncode != 0:
                raise CaptureError(
                    result.stderr.strip()
                    or f"{COMMAND_GNOME_SCREENSHOT} failed"
                )
        finally:
            if previous_animation_setting in {"true", "false"}:
                self._set_animation_setting(previous_animation_setting)

        if not raw_path.exists() or raw_path.stat().st_size == 0:
            raise CaptureError("gnome-screenshot did not create a screenshot")

    def close(self) -> None:
        return None

    @staticmethod
    def _get_animation_setting() -> str | None:
        try:
            result = subprocess.run(
                [
                    COMMAND_GSETTINGS,
                    "get",
                    GSETTINGS_INTERFACE_SCHEMA,
                    GSETTINGS_ENABLE_ANIMATIONS_KEY,
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
        except OSError:
            return None
        if result.returncode != 0:
            return None
        return result.stdout.strip()

    @staticmethod
    def _set_animation_setting(value: str) -> None:
        try:
            subprocess.run(
                [
                    COMMAND_GSETTINGS,
                    "set",
                    GSETTINGS_INTERFACE_SCHEMA,
                    GSETTINGS_ENABLE_ANIMATIONS_KEY,
                    value,
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            pass


class PortalScreenCastSession:
    SOURCE_WINDOW = 2
    CURSOR_HIDDEN = 1

    def __init__(self) -> None:
        if dbus is None:
            raise CaptureError("python3-dbus is not available")

        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
        self.bus = dbus.SessionBus()
        self.portal = self.bus.get_object(PORTAL_BUS_NAME, PORTAL_OBJECT_PATH)
        self.screencast = dbus.Interface(self.portal, SCREENCAST_IFACE)
        self.properties = dbus.Interface(self.portal, "org.freedesktop.DBus.Properties")
        self.session_handle: str | None = None
        self.pipewire_fd: int | None = None
        self.node_id: int | None = None
        self.pipewire_serial: int | None = None

    def start_window_selection(self) -> None:
        available_sources = int(self.properties.Get(SCREENCAST_IFACE, "AvailableSourceTypes"))
        if not available_sources & self.SOURCE_WINDOW:
            raise CaptureError("The desktop portal does not advertise window capture")

        session_token = self._token("session")
        create_result = self._request(
            "CreateSession",
            (),
            {"session_handle_token": dbus.String(session_token)},
        )
        self.session_handle = str(create_result["session_handle"])

        self._request(
            "SelectSources",
            (dbus.ObjectPath(self.session_handle),),
            {
                "types": dbus.UInt32(self.SOURCE_WINDOW),
                "multiple": dbus.Boolean(False),
                "cursor_mode": dbus.UInt32(self.CURSOR_HIDDEN),
            },
        )

        start_result = self._request("Start", (dbus.ObjectPath(self.session_handle), ""), {})
        streams = start_result.get("streams")
        if not streams:
            raise CaptureError("The portal did not return a PipeWire stream")

        stream = streams[0]
        self.node_id = int(stream[0])
        properties = {str(key): value for key, value in dict(stream[1]).items()}
        if "pipewire-serial" in properties:
            self.pipewire_serial = int(properties["pipewire-serial"])

        fd = self.screencast.OpenPipeWireRemote(
            dbus.ObjectPath(self.session_handle),
            dbus.Dictionary({}, signature="sv"),
        )
        self.pipewire_fd = fd.take() if hasattr(fd, "take") else int(fd)

    def capture(self, raw_path: Path) -> None:
        if self.pipewire_fd is None or self.node_id is None:
            raise CaptureError("PipeWire stream is not open")

        raw_path.unlink(missing_ok=True)
        duplicated_fd = os.dup(self.pipewire_fd)
        pipeline = Gst.Pipeline.new("lapser3-window-snapshot")

        elements = {
            "source": Gst.ElementFactory.make("pipewiresrc", "source"),
            "queue": Gst.ElementFactory.make("queue", "queue"),
            "converter": Gst.ElementFactory.make("videoconvert", "converter"),
            "caps": Gst.ElementFactory.make("capsfilter", "caps"),
            "encoder": Gst.ElementFactory.make("jpegenc", "encoder"),
            "sink": Gst.ElementFactory.make("filesink", "sink"),
        }
        missing = [name for name, element in elements.items() if element is None]
        if missing:
            self._close_fd(duplicated_fd)
            raise CaptureError(f"Missing GStreamer elements: {', '.join(missing)}")

        source = elements["source"]
        source.set_property("fd", duplicated_fd)
        source.set_property("client-name", "lapser3")
        source.set_property("num-buffers", 1)
        source.set_property("do-timestamp", True)
        source.set_property("resend-last", True)
        source.set_property("keepalive-time", 1000)
        if self.pipewire_serial is not None:
            source.set_property("target-object", str(self.pipewire_serial))
        else:
            source.set_property("path", str(self.node_id))

        elements["caps"].set_property("caps", Gst.Caps.from_string("video/x-raw,format=RGB"))
        elements["encoder"].set_property("snapshot", True)
        elements["encoder"].set_property("quality", WINDOW_SNAPSHOT_JPEG_QUALITY)
        elements["sink"].set_property("location", str(raw_path))
        elements["sink"].set_property("sync", False)
        elements["sink"].set_property("async", False)

        for element in elements.values():
            pipeline.add(element)

        ordered = list(elements.values())
        for left, right in zip(ordered, ordered[1:]):
            if not left.link(right):
                pipeline.set_state(Gst.State.NULL)
                self._close_fd(duplicated_fd)
                raise CaptureError("Could not link the GStreamer snapshot pipeline")

        bus = pipeline.get_bus()
        try:
            state_change = pipeline.set_state(Gst.State.PLAYING)
            if state_change == Gst.StateChangeReturn.FAILURE:
                raise CaptureError("Could not start the GStreamer snapshot pipeline")

            message = bus.timed_pop_filtered(
                GST_CAPTURE_TIMEOUT,
                Gst.MessageType.ERROR | Gst.MessageType.EOS,
            )
            if message is None:
                raise CaptureError("Timed out waiting for a PipeWire frame")
            if message.type == Gst.MessageType.ERROR:
                error, debug = message.parse_error()
                detail = error.message
                if debug:
                    detail = f"{detail} ({debug})"
                raise CaptureError(detail)
        finally:
            pipeline.set_state(Gst.State.NULL)
            self._close_fd(duplicated_fd)

        if not raw_path.exists() or raw_path.stat().st_size == 0:
            raise CaptureError("GStreamer did not create a screenshot")

    def close(self) -> None:
        if self.pipewire_fd is not None:
            self._close_fd(self.pipewire_fd)
            self.pipewire_fd = None

        if self.session_handle is not None:
            try:
                session = self.bus.get_object(PORTAL_BUS_NAME, self.session_handle)
                dbus.Interface(session, SESSION_IFACE).Close()
            except Exception:
                pass
            self.session_handle = None

    def _request(
        self,
        method_name: str,
        args: tuple[Any, ...],
        options: dict[str, Any],
    ) -> dict[str, Any]:
        token = self._token(method_name.lower())
        request_path = self._request_path(token)
        loop = GLib.MainLoop()
        response_data: dict[str, Any] = {}

        def on_response(response: int, results: dict[str, Any]) -> None:
            response_data["response"] = int(response)
            response_data["results"] = results
            loop.quit()

        receiver_path = request_path
        self.bus.add_signal_receiver(
            on_response,
            signal_name="Response",
            dbus_interface=REQUEST_IFACE,
            path=receiver_path,
        )

        call_options = dict(options)
        call_options["handle_token"] = dbus.String(token)
        method = getattr(self.screencast, method_name)
        handle = method(*args, dbus.Dictionary(call_options, signature="sv"))
        returned_path = str(handle)

        if returned_path != request_path:
            self.bus.remove_signal_receiver(
                on_response,
                signal_name="Response",
                dbus_interface=REQUEST_IFACE,
                path=receiver_path,
            )
            receiver_path = returned_path
            self.bus.add_signal_receiver(
                on_response,
                signal_name="Response",
                dbus_interface=REQUEST_IFACE,
                path=receiver_path,
            )

        timed_out = False

        def on_timeout() -> bool:
            nonlocal timed_out
            timed_out = True
            response_data["response"] = 2
            response_data["results"] = {}
            loop.quit()
            return False

        timeout_id = GLib.timeout_add_seconds(PORTAL_REQUEST_TIMEOUT_SECONDS, on_timeout)
        loop.run()
        if not timed_out:
            GLib.source_remove(timeout_id)
        self.bus.remove_signal_receiver(
            on_response,
            signal_name="Response",
            dbus_interface=REQUEST_IFACE,
            path=receiver_path,
        )

        response = response_data.get("response", 2)
        if response == 1:
            raise PortalCancelled("The portal request was cancelled")
        if response != 0:
            raise CaptureError("The portal request failed")
        return response_data.get("results", {})

    def _request_path(self, token: str) -> str:
        sender = self.bus.get_unique_name().lstrip(":").replace(".", "_")
        return f"/org/freedesktop/portal/desktop/request/{sender}/{token}"

    @staticmethod
    def _token(prefix: str) -> str:
        return f"lapser3_{prefix}_{uuid.uuid4().hex}"

    @staticmethod
    def _close_fd(fd: int) -> None:
        try:
            os.close(fd)
        except OSError:
            pass


class PortalWindowCapture:
    name = "Window"

    def __init__(self) -> None:
        self.session = PortalScreenCastSession()
        self.session.start_window_selection()

    def capture(self, raw_path: Path) -> None:
        self.session.capture(raw_path)

    def close(self) -> None:
        self.session.close()


