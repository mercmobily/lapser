        movie_path=pending_movie_path(paths, set_name),
        log_path=paths.movies_not_uploaded_dir / f"{set_name}{LOG_SUFFIX}",
        temporary_video=temp_lapser_path("video", VIDEO_SUFFIX),
    )


def manual_video_targets(paths: ProfilePaths, set_name: str) -> ManualVideoTargets:
    return ManualVideoTargets(
        movie_path=pending_movie_path(paths, set_name),
        log_path=paths.movies_not_uploaded_dir / f"{set_name}{LOG_SUFFIX}",
        temporary_card=temp_lapser_path("manual-card", JPG_SUFFIX),
        temporary_video=temp_lapser_path("manual-video", VIDEO_SUFFIX),
        temporary_log=temp_lapser_path("manual-video", LOG_SUFFIX),
    )


def manual_video_conflict(paths: ProfilePaths, set_name: str) -> bool:
    return any(
        path.exists()
        for path in (
            pending_movie_path(paths, set_name),
            uploaded_movie_path(paths, set_name),
            paths.movies_not_uploaded_dir / f"{set_name}{LOG_SUFFIX}",
            paths.movies_uploaded_dir / f"{set_name}{LOG_SUFFIX}",
            converted_set_dir(paths, set_name),
            paths.shots_not_converted_dir / set_name,
        )
    )


def validate_manual_video_request(
    paths: ProfilePaths,
    started_text: str,
    finished_text: str,
    sentence_text: str,
) -> tuple[ManualVideoRequest | None, str]:
    sentence = " ".join(sentence_text.split())
    if not sentence:
        return None, "Enter the sentence to show in the video."
    if len(sentence) > MANUAL_SENTENCE_MAX_LENGTH:
        return None, f"Keep the sentence to {MANUAL_SENTENCE_MAX_LENGTH} characters."

    started = parse_manual_datetime(started_text)
    finished = parse_manual_datetime(finished_text)
    if started is None or finished is None:
        return (
            None,
            "Use a date and time like "
            f"{datetime.now().strftime(MANUAL_DATETIME_ENTRY_FORMAT)}.",
        )
    if finished <= started:
        return None, "Finish must be later than start."

    set_name = manual_video_set_name(started, finished)
    if manual_video_conflict(paths, set_name):
        return None, "A video or screenshot set already uses this time range."

    work_seconds = (finished - started).total_seconds()
    video_seconds = manual_video_playback_seconds(work_seconds)
    request = ManualVideoRequest(
        profile_name=paths.name,
        started=started,
        finished=finished,
        sentence=sentence,
        set_name=set_name,
        work_seconds=work_seconds,
        video_seconds=video_seconds,
    )
    return (
        request,
        f"{format_duration(work_seconds)} worked · creates a "
        f"{format_duration(video_seconds, zero_unit='s')} video",
    )


def render_manual_video_card(sentence: str, target: Path) -> None:
    point_size = manual_card_point_size(sentence)
    try:
        result = subprocess.run(
            [
                COMMAND_IMAGEMAGICK_CONVERT,
                "-size",
                f"{MANUAL_CARD_TEXT_WIDTH}x{MANUAL_CARD_TEXT_HEIGHT}",
                "-background",
                MANUAL_CARD_BACKGROUND,
                "-fill",
                "white",
                "-font",
                MANUAL_CARD_FONT,
                "-pointsize",
                str(point_size),
                "-gravity",
                "center",
                f"caption:{sentence}",
                "-gravity",
                "center",
                "-extent",
                f"{MANUAL_CARD_WIDTH}x{MANUAL_CARD_HEIGHT}",
                "-quality",
                "90",
                str(target),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as error:
        raise CaptureError(
            f"Could not run {COMMAND_IMAGEMAGICK_CONVERT}: {error}"
        ) from error
    if result.returncode != 0:
        raise CaptureError(result.stderr.strip() or "Could not create the video card")
