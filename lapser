def shot_cache_key(shot: Path) -> ShotCacheKey | None:
    try:
        stat = shot.stat()
    except FileNotFoundError:
        return None
    return (shot.name, stat.st_size, stat.st_mtime_ns)


def shot_list_signature(shots: list[Path]) -> MediaSignature:
    keys = [shot_cache_key(shot) for shot in shots]
    return tuple(key for key in keys if key is not None)


def thumbnail_widget_key(context_key: str, key: ShotCacheKey) -> ThumbnailWidgetKey:
    return (context_key, key[0], key[1], key[2])


def thumbnail_path(paths: ProfilePaths, shot: Path, key: ShotCacheKey) -> Path:
    name, size, mtime = key
    return paths.thumbnail_dir / f"{Path(name).stem}-{size}-{mtime}{JPG_SUFFIX}"


def create_thumbnail(paths: ProfilePaths, shot: Path, key: ShotCacheKey) -> Path | None:
    if shot_cache_key(shot) != key:
        return None

    target = thumbnail_path(paths, shot, key)
    if target.exists():
        return target

    paths.thumbnail_dir.mkdir(parents=True, exist_ok=True)
    temporary = target.with_suffix(TEMP_JPG_SUFFIX)
    try:
        result = subprocess.run(
            [
                COMMAND_IMAGEMAGICK_CONVERT,
                str(shot),
                "-auto-orient",
                "-thumbnail",
                f"{THUMB_WIDTH}x{THUMB_HEIGHT}^",
                "-gravity",
                "center",
                "-extent",
                f"{THUMB_WIDTH}x{THUMB_HEIGHT}",
                "-quality",
                THUMBNAIL_QUALITY,
                str(temporary),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as error:
        temporary.unlink(missing_ok=True)
        raise CaptureError(f"Could not run {COMMAND_IMAGEMAGICK_CONVERT}: {error}") from error
    if result.returncode != 0:
        temporary.unlink(missing_ok=True)
        raise CaptureError(result.stderr.strip() or "Thumbnail creation failed")

    temporary.replace(target)
    return target


def remove_thumbnail_cache(paths: ProfilePaths, shot: Path) -> None:
    if not paths.thumbnail_dir.exists():
        return

    for cached in paths.thumbnail_dir.glob(f"{shot.stem}-*{JPG_SUFFIX}"):
        try:
            cached.unlink()
        except OSError:
            pass


