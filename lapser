def command_exists(command: str) -> bool:
    return shutil.which(command) is not None


def check_dependencies() -> DependencyStatus:
    Gst.init(None)

    missing_thumbnail = (
        [] if command_exists(COMMAND_IMAGEMAGICK_CONVERT)
        else [DEPENDENCY_IMAGEMAGICK_CONVERT]
    )
    missing_screen = []
    for command in (COMMAND_GNOME_SCREENSHOT, COMMAND_GSETTINGS):
        if not command_exists(command):
            missing_screen.append(command)
    missing_screen.extend(missing_thumbnail)

    missing_conversion = [] if command_exists(COMMAND_FFMPEG) else [COMMAND_FFMPEG]
    missing_window = []
    missing_window.extend(missing_thumbnail)
    if dbus is None:
        missing_window.append(DEPENDENCY_PYTHON_DBUS)
    for element_name in GSTREAMER_SNAPSHOT_ELEMENTS:
        if Gst.ElementFactory.find(element_name) is None:
            missing_window.append(f"gstreamer {element_name}")

    return DependencyStatus(
        missing_screen=tuple(missing_screen),
        missing_window=tuple(missing_window),
        missing_conversion=tuple(missing_conversion),
        missing_thumbnail=tuple(missing_thumbnail),
    )


def run_check_deps() -> int:
    dependencies = check_dependencies()
    checks = (
        ("Screen capture", dependencies.missing_screen),
        ("Selected-window capture", dependencies.missing_window),
        ("Video conversion", dependencies.missing_conversion),
        ("Thumbnail generation", dependencies.missing_thumbnail),
    )
    for label, missing in checks:
        if missing:
            print(f"{label} is missing:")
            for item in missing:
                print(f"  {item}")
        else:
            print(f"{label}: ok")

    if dependencies.has_missing:
        print()
        print("Install the missing dependencies to enable the disabled features.")
        for item in dependencies.install_targets():
            print(f"  {item}")

    return 1 if dependencies.has_missing else 0


