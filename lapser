    )


def recursive_jpg_count(directory: Path) -> int:
    if not directory.exists():
        return 0
    return sum(
        1
        for path in directory.rglob("*")
        if path.is_file() and path.suffix.lower() == JPG_SUFFIX
    )


def video_duration_cache_key(video_path: Path) -> VideoDurationCacheKey | None:
    try:
        stat = video_path.stat()
    except FileNotFoundError:
        return None
    return (str(video_path), stat.st_size, stat.st_mtime_ns)


def probe_video_duration(video_path: Path) -> float | None:
    try:
        result = subprocess.run(
            [
                COMMAND_FFPROBE,
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(video_path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None

    if result.returncode != 0:
        return None
    try:
        duration = float(result.stdout.strip())
    except ValueError:
        return None
    if not math.isfinite(duration) or duration < 0:
        return None
    return duration


def video_log_path(video_path: Path) -> Path:
    return video_path.with_suffix(LOG_SUFFIX)


def move_video_pair(
    source_dir: Path,
    destination_dir: Path,
    video_name: str,
    missing_message: str = "Video is missing.",
    exists_message: str = "Destination video already exists.",
    log_exists_message: str = "Destination log already exists.",
) -> None:
    source = source_dir / video_name
    destination = destination_dir / video_name
    source_log = video_log_path(source)
    destination_log = video_log_path(destination)

    if not source.exists():
        raise CaptureError(missing_message)
    if destination.exists():
        raise CaptureError(exists_message)
    if source_log.exists() and destination_log.exists():
        raise CaptureError(log_exists_message)

    try:
        shutil.move(str(source), str(destination))
        if source_log.exists():
            shutil.move(str(source_log), str(destination_log))
    except OSError as error:
        raise CaptureError(str(error)) from error


def file_signature(files: list[Path]) -> MediaSignature:
    keys = []
    for file_path in files:
        try:
            stat = file_path.stat()
        except FileNotFoundError:
            continue
        keys.append((file_path.name, stat.st_size, stat.st_mtime_ns))
    return tuple(keys)


def ffmpeg_error_summary(lines: list[str]) -> str:
    progress_prefixes = (
        "bitrate=",
        "drop_frames=",
        "dup_frames=",
        "fps=",
        "frame=",
        "out_time",
        "progress=",
        "speed=",
        "stream_",
        "total_size=",
    )
    for line in reversed(lines):
        if not line or line.startswith(progress_prefixes):
            continue
        return line[:180]
    return "ffmpeg failed"


