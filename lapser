def timestamp() -> str:
    return datetime.now().strftime(LAPSER_TIMESTAMP_FORMAT)


def lapser_timestamp(value: datetime) -> str:
    return value.strftime(LAPSER_TIMESTAMP_FORMAT)


def manual_datetime_text(value: datetime) -> str:
    return value.strftime(MANUAL_DATETIME_ENTRY_FORMAT)


def parse_manual_datetime(raw: str) -> datetime | None:
    value = raw.strip()
    for date_format in (
        MANUAL_DATETIME_ENTRY_FORMAT,
        f"{MANUAL_DATETIME_ENTRY_FORMAT}:%S",
        LAPSER_TIMESTAMP_FORMAT,
    ):
        try:
            return datetime.strptime(value, date_format)
        except ValueError:
            continue
    return None


def parse_lapser_timestamp(raw: str) -> datetime | None:
    try:
        return datetime.strptime(raw, LAPSER_TIMESTAMP_FORMAT)
    except ValueError:
        return None


def locale_datetime(raw: str) -> str:
    parsed = parse_lapser_timestamp(raw)
    if parsed is None:
        return raw
    return " ".join(parsed.strftime("%c").split())


def display_timestamp(raw: str) -> str:
    return locale_datetime(raw)


def converted_set_range(name: str) -> str:
    if CONVERTED_SET_SEPARATOR not in name:
        return display_timestamp(name)

    start, end = name.split(CONVERTED_SET_SEPARATOR, 1)
    return f"{display_timestamp(start)} to {display_timestamp(end)}"


def strip_known_media_suffix(name: str) -> str:
    suffix = Path(name).suffix.lower()
    if suffix in MEDIA_SUFFIXES:
        return name[: -len(suffix)]
    return name


def display_lapser_name(name: str) -> str:
    stem = strip_known_media_suffix(name)
    if CONVERTED_SET_SEPARATOR in stem:
        return converted_set_range(stem)
    if parse_lapser_timestamp(stem) is not None:
        return display_timestamp(stem)
    if CONVERTED_SET_SEPARATOR in name:
        displayed = converted_set_range(name)
        if displayed != name:
            return displayed
    return name


def format_duration(seconds: float, zero_unit: str = "m") -> str:
    total_seconds = max(int(round(seconds)), 0)
    hours, remainder = divmod(total_seconds, 60 * 60)
    minutes, seconds_part = divmod(remainder, 60)
    parts = []
    if hours:
        parts.append(f"{hours}h")
    if minutes:
        parts.append(f"{minutes}m")
    if seconds_part:
        parts.append(f"{seconds_part}s")
    return " ".join(parts) if parts else f"0{zero_unit}"


def parse_billed_duration(raw: str) -> float | None:
    """Parse flexible user-entered billable time and return seconds."""
    value = raw.strip()
    if not value:
        return 0.0

    clock_match = BILLED_CLOCK_RE.fullmatch(value)
    if clock_match is not None:
        hours = float(clock_match.group("hours"))
        minutes = float(clock_match.group("minutes"))
        seconds_part = float(clock_match.group("seconds") or 0)
        return hours * 60 * 60 + minutes * 60 + seconds_part

    try:
        decimal_hours = float(value)
    except ValueError:
        decimal_hours = -1
    if decimal_hours >= 0 and math.isfinite(decimal_hours):
        return decimal_hours * 60 * 60

    matches = list(BILLED_TIME_PART_RE.finditer(value))
    if not matches or BILLED_TIME_PART_RE.sub("", value).strip():
        return None

    total_seconds = 0.0
    for match in matches:
        amount = float(match.group("value"))
        unit = match.group("unit").lower()
        if unit.startswith("h"):
            total_seconds += amount * 60 * 60
        elif unit.startswith("m"):
            total_seconds += amount * 60
        else:
            total_seconds += amount
    return total_seconds


