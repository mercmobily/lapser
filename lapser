    def play_video(self, video_path: Path) -> None:
        if not video_path.exists():
            self.toast("Video is missing.")
            return

        display_name = display_lapser_name(video_path.name)
        window = Adw.Window(application=self.get_application())
        window.set_title(display_name)
        window.set_transient_for(self)
        window.set_default_size(900, 560)

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title=display_name, subtitle=video_path.name))
        header.pack_end(
            self.make_open_folder_button(
                video_path,
                f"Open folder containing {video_path.name}",
            )
        )
        toolbar.add_top_bar(header)

        media_file = Gtk.MediaFile.new_for_file(Gio.File.new_for_path(str(video_path)))
        media_file.connect("notify::error", self.on_video_playback_error, video_path)

        video = Gtk.Video.new_for_media_stream(media_file)
        video.set_autoplay(True)
        video.set_vexpand(True)
        video.set_hexpand(True)
        toolbar.set_content(video)

        window.set_content(toolbar)
        window.connect("close-request", self.on_video_window_close, media_file)
        self.video_windows.append(window)
        window.present()
        media_file.play()

