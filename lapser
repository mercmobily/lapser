    def start_manual_video(self, request: ManualVideoRequest) -> None:
        paths = ProfilePaths.for_name(request.profile_name)
        paths.ensure()
        if request.profile_name in self.jobs:
            self.toast("Stop recording before creating a manual video.")
            return
        if request.profile_name in self.converting_profiles:
            self.toast("This profile is already creating a video.")
            return
        if manual_video_conflict(paths, request.set_name):
            self.toast("A video or screenshot set already uses this time range.")
            return

        self.converting_profiles.add(request.profile_name)
        self.manual_video_profiles.add(request.profile_name)
        self.conversion_progress[request.profile_name] = 0.0
        self.cancelled_conversions.discard(request.profile_name)
        self.toast(
            f"Creating manual video: {converted_set_range(request.set_name)}"
        )
        if self.selected_profile == request.profile_name:
            self.refresh_profile_view()
        else:
            self.refresh_profile_rows()
        threading.Thread(
            target=self.manual_video_worker,
            args=(request,),
            daemon=True,
        ).start()

    def manual_video_worker(self, request: ManualVideoRequest) -> None:
        paths = ProfilePaths.for_name(request.profile_name)
        targets = manual_video_targets(paths, request.set_name)
        movie_installed = False
        log_installed = False
        message = ""

        try:
            if manual_video_conflict(paths, request.set_name):
                raise CaptureError("A video or screenshot set already uses this time range")

            render_manual_video_card(request.sentence, targets.temporary_card)
            write_manual_video_log(request, targets.temporary_log)
            if request.profile_name in self.cancelled_conversions:
                raise PortalCancelled("Manual video cancelled")

            command = [
                COMMAND_FFMPEG,
                "-y",
                "-loop",
                "1",
                "-framerate",
                str(VIDEO_FRAMERATE),
                "-i",
                str(targets.temporary_card),
                "-t",
                f"{request.video_seconds:.3f}",
                "-an",
                "-c:v",
                "libx264",
                "-tune",
                "stillimage",
                "-preset",
                "veryfast",
                "-crf",
                MANUAL_VIDEO_CRF,
                "-pix_fmt",
                VIDEO_PIXEL_FORMAT,
                "-movflags",
                "+faststart",
                "-metadata",
                f"title={request.sentence}",
                "-metadata",
                (
                    "comment=Manual Lapser video representing "
                    f"{format_duration(request.work_seconds)} worked"
                ),
                "-progress",
                "pipe:1",
                "-nostats",
                str(targets.temporary_video),
            ]
            process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
            self.conversion_processes[request.profile_name] = process
            output_lines: list[str] = []
            total_frames = max(
                int(math.ceil(request.video_seconds * VIDEO_FRAMERATE)),
                1,
            )

            if process.stdout is not None:
                for line in process.stdout:
                    line = line.strip()
                    if line:
                        output_lines.append(line)
                    progress = self.ffmpeg_progress_fraction(
                        line,
                        total_frames,
                        request.video_seconds,
                    )
                    if progress is not None:
                        GLib.idle_add(
                            self.update_conversion_progress,
                            request.profile_name,
                            progress,
                        )

            return_code = process.wait()
            self.conversion_processes.pop(request.profile_name, None)
            if request.profile_name in self.cancelled_conversions:
                raise PortalCancelled("Manual video cancelled")
            if return_code != 0:
                raise CaptureError(ffmpeg_error_summary(output_lines))

            GLib.idle_add(
                self.update_conversion_progress,
                request.profile_name,
                POST_ENCODE_PROGRESS,
            )
            if manual_video_conflict(paths, request.set_name):
                raise CaptureError("A video or screenshot set now uses this time range")

            shutil.move(str(targets.temporary_log), str(targets.log_path))
            log_installed = True
            shutil.move(str(targets.temporary_video), str(targets.movie_path))
            movie_installed = True
            GLib.idle_add(self.update_conversion_progress, request.profile_name, 1.0)
            message = f"Manual video created: {display_lapser_name(targets.movie_path.name)}"
        except PortalCancelled as error:
            message = str(error)
        except (CaptureError, OSError, subprocess.SubprocessError) as error:
            message = f"Could not create manual video: {error}"

        self.conversion_processes.pop(request.profile_name, None)
        cleanup_manual_video_targets(targets)
        if not movie_installed and log_installed:
            targets.log_path.unlink(missing_ok=True)
        if movie_installed and not log_installed:
            targets.movie_path.unlink(missing_ok=True)
        GLib.idle_add(self.manual_video_finished, request.profile_name, message)

    def manual_video_finished(self, profile_name: str, message: str) -> bool:
        self.manual_video_profiles.discard(profile_name)
        self.converting_profiles.discard(profile_name)
        self.conversion_processes.pop(profile_name, None)
        self.conversion_progress.pop(profile_name, None)
        self.cancelled_conversions.discard(profile_name)
        self.toast(message)
        self.invalidate_video_lifecycle(profile_name)
        self.refresh_after_media_change(profile_name)
        return False

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: CONVERSION LIFECYCLE
    # Description: Convert current screenshots to a movie, report ffmpeg progress,
    #              support cancellation, and clean up failed/staged output.
    # ==========================================================================

    def convert_current(self) -> None:
        paths = self.selected_paths()
        if paths is None:
            return
        if not self.dependencies.conversion_available:
            self.toast(
                self.unavailable_tooltip(
                    self.dependencies.missing_conversion,
                    "Video conversion is unavailable.",
                )
            )
            return
        if paths.name in self.jobs:
            self.toast("Stop recording before converting.")
            return
        if paths.name in self.converting_profiles:
            self.toast("This profile is already converting.")
            return

        shots = current_shot_files(paths)
        if not has_enough_shots_to_convert(shots):
            self.toast(f"Need at least {MIN_SHOTS_TO_CONVERT} screenshots to convert.")
            return

        set_name = converted_set_name_for(shots)
        if set_name is None:
            self.toast("Could not name the converted set.")
            return

        converted_dir = converted_set_dir(paths, set_name)
        movie_path = pending_movie_path(paths, set_name)
        if converted_dir.exists() or movie_path.exists():
            self.toast("Converted output already exists.")
            return

        self.converting_profiles.add(paths.name)
        self.conversion_progress[paths.name] = 0.0
        self.cancelled_conversions.discard(paths.name)
        self.toast(f"Converting {converted_set_range(set_name)}")
        self.refresh_profile_view()
        threading.Thread(
            target=self.convert_current_worker,
            args=(paths.name, set_name),
            daemon=True,
        ).start()

    def cancel_selected_conversion(self) -> None:
        if self.selected_profile is not None:
            self.cancel_conversion(self.selected_profile)

    def cancel_conversion(self, profile_name: str) -> None:
        if profile_name not in self.converting_profiles:
            return

        self.cancelled_conversions.add(profile_name)
        process = self.conversion_processes.get(profile_name)
        if process is not None and process.poll() is None:
            process.terminate()
            GLib.timeout_add_seconds(
                CONVERSION_CANCEL_KILL_DELAY_SECONDS,
                self.kill_conversion_if_needed,
                profile_name,
                process,
            )
        if profile_name in self.manual_video_profiles:
            self.toast(f"Cancelling manual video: {profile_name}")
        else:
            self.toast(f"Cancelling conversion: {profile_name}")
        if self.selected_profile == profile_name:
            paths = self.selected_paths()
            if paths is not None:
                self.refresh_status_controls(paths, len(current_shot_files(paths)))

    def kill_conversion_if_needed(self, profile_name: str, process: subprocess.Popen[str]) -> bool:
        if self.conversion_processes.get(profile_name) is process and process.poll() is None:
            process.kill()
        return False

    def convert_current_worker(self, profile_name: str, set_name: str) -> None:
        paths = ProfilePaths.for_name(profile_name)
        targets = conversion_targets(paths, set_name)

        message = ""
        try:
            if targets.converted_dir.exists() or targets.movie_path.exists():
                raise CaptureError("Converted output already exists")

            shots = current_shot_files(paths)
            if not has_enough_shots_to_convert(shots):
                raise CaptureError(
                    f"Need at least {MIN_SHOTS_TO_CONVERT} screenshots to convert"
                )

            command = [
                COMMAND_FFMPEG,
                "-y",
                "-framerate",
                str(VIDEO_FRAMERATE),
                "-pattern_type",
                "glob",
                "-i",
                str(paths.shots_current_dir / f"*{JPG_SUFFIX}"),
                "-b:v",
                VIDEO_BITRATE,
                "-pix_fmt",
                VIDEO_PIXEL_FORMAT,
                "-progress",
                "pipe:1",
                "-nostats",
                str(targets.temporary_video),
            ]
            process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
            self.conversion_processes[profile_name] = process
            output_lines: list[str] = []
            total_frames = max(len(shots), 1)
            total_seconds = total_frames / VIDEO_FRAMERATE

            if process.stdout is not None:
                for line in process.stdout:
                    line = line.strip()
                    if line:
                        output_lines.append(line)
                    progress = self.ffmpeg_progress_fraction(line, total_frames, total_seconds)
                    if progress is not None:
                        GLib.idle_add(self.update_conversion_progress, profile_name, progress)

            return_code = process.wait()
            self.conversion_processes.pop(profile_name, None)

            if profile_name in self.cancelled_conversions:
                raise PortalCancelled("Conversion cancelled")
            if return_code != 0:
                raise CaptureError(ffmpeg_error_summary(output_lines))

            GLib.idle_add(
                self.update_conversion_progress,
                profile_name,
                POST_ENCODE_PROGRESS,
            )

            if profile_name in self.cancelled_conversions:
                raise PortalCancelled("Conversion cancelled")

            targets.staging_dir.mkdir()
            for shot in shots:
                if profile_name in self.cancelled_conversions:
                    raise PortalCancelled("Conversion cancelled")
                remove_thumbnail_cache(paths, shot)
                shutil.move(str(shot), str(targets.staging_dir / shot.name))
            shutil.copy2(paths.log_file, targets.staging_dir / paths.log_file.name)
            shutil.move(str(targets.temporary_video), str(targets.movie_path))
            shutil.copy2(targets.staging_dir / "log.txt", targets.log_path)
            targets.staging_dir.rename(targets.converted_dir)
            try:
                paths.log_file.write_text("", encoding="utf-8")
            except OSError:
                pass

            GLib.idle_add(self.update_conversion_progress, profile_name, 1.0)
            message = f"Movie created: {display_lapser_name(targets.movie_path.name)}"
        except PortalCancelled as error:
            self.cleanup_failed_conversion(paths, targets)
            message = str(error)
        except (CaptureError, OSError, subprocess.SubprocessError) as error:
            self.cleanup_failed_conversion(paths, targets)
            message = f"Could not convert current screenshots: {error}"

        GLib.idle_add(self.convert_current_finished, profile_name, message)

    def ffmpeg_progress_fraction(
        self,
        line: str,
        total_frames: int,
        total_seconds: float,
    ) -> float | None:
        if line.startswith("frame="):
            try:
                return clamp(
                    int(line.split("=", 1)[1]) / total_frames,
                    upper=FFMPEG_PROGRESS_LIMIT,
                )
            except ValueError:
                return None

        if line.startswith(("out_time_ms=", "out_time_us=")):
            try:
                elapsed = int(line.split("=", 1)[1]) / 1_000_000
                return clamp(elapsed / total_seconds, upper=FFMPEG_PROGRESS_LIMIT)
            except ValueError:
                return None

        return None

    def cleanup_failed_conversion(
        self,
        paths: ProfilePaths,
        targets: ConversionTargets,
    ) -> None:
        targets.temporary_video.unlink(missing_ok=True)
        targets.movie_path.unlink(missing_ok=True)
        targets.log_path.unlink(missing_ok=True)
        if targets.staging_dir.exists():
            for shot in sorted(targets.staging_dir.glob(f"*{JPG_SUFFIX}")):
                destination = paths.shots_current_dir / shot.name
                if not destination.exists():
                    try:
                        shutil.move(str(shot), str(destination))
                    except OSError:
                        pass
            shutil.rmtree(targets.staging_dir, ignore_errors=True)

    def update_conversion_progress(self, profile_name: str, progress: float) -> bool:
        self.conversion_progress[profile_name] = clamp(progress)
        if self.selected_profile == profile_name:
            paths = self.selected_paths()
            if paths is not None:
                self.refresh_conversion_progress(paths)
        return False

    def convert_current_finished(self, profile_name: str, message: str) -> bool:
        self.converting_profiles.discard(profile_name)
        self.conversion_processes.pop(profile_name, None)
        self.conversion_progress.pop(profile_name, None)
        self.cancelled_conversions.discard(profile_name)
        self.toast(message)
        self.selected_shot = None
        self.invalidate_current_shots(profile_name)
        self.invalidate_video_lifecycle(profile_name)
        self.refresh_after_media_change(profile_name)
        return False

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: VIDEO LIFECYCLE
    # Description: Move videos between not-uploaded, uploaded, and permanently
    #              preserved discarded states.
