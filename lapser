    def on_key_pressed(
        self,
        _controller: Gtk.EventControllerKey,
        keyval: int,
        _keycode: int,
        _state: Gdk.ModifierType,
    ) -> bool:
        if keyval != Gdk.KEY_Delete:
            return False

        focus = self.get_focus()
        if isinstance(focus, (Gtk.Entry, Gtk.TextView)):
            return False

        if self.lifecycle_stack.get_visible_child_name() != PAGE_CURRENT:
            return False

        return self.delete_selected_screenshot()

    def on_thumb_selection_changed(self, flow: Gtk.FlowBox) -> None:
        selected = flow.get_selected_children()
        if not selected:
            return

        shot = getattr(selected[0], "shot_path", None)
        if shot is not None:
            self.selected_shot = shot

    def on_thumb_activated(self, _flow: Gtk.FlowBox, child: Gtk.FlowBoxChild) -> None:
        if getattr(child, "shot_path", None) is None:
            return
        self.selected_shot = child.shot_path

    def on_delete_clicked(self, button: Gtk.Button, profile_name: str, shot: Path) -> None:
        self.delete_screenshot(profile_name, shot)

    def delete_selected_screenshot(self) -> bool:
        if self.selected_profile is None:
            return False

        if self.selected_shot is None:
            selected = self.thumb_flow.get_selected_children()
            if selected:
                self.selected_shot = getattr(selected[0], "shot_path", None)

        if self.selected_shot is None:
            return False

        self.delete_screenshot(self.selected_profile, self.selected_shot)
        return True

    def successor_after_delete(self, paths: ProfilePaths, shot: Path) -> Path | None:
        visual_order = list(reversed(current_shot_files(paths)))
        try:
            index = visual_order.index(shot)
        except ValueError:
            return None

        if index + 1 < len(visual_order):
            return visual_order[index + 1]
        if index > 0:
            return visual_order[index - 1]
        return None

    def select_visible_shot(self, shot: Path | None) -> None:
        if shot is None:
            return

        child = self.thumb_flow.get_first_child()
        while child is not None:
            if getattr(child, "shot_path", None) == shot:
                self.thumb_flow.select_child(child)
                child.grab_focus()
                self.selected_shot = shot
                return
            child = child.get_next_sibling()

    def delete_screenshot(self, profile_name: str, shot: Path) -> None:
        token = uuid.uuid4().hex
        paths = ProfilePaths.for_name(profile_name)
        paths.ensure()
        next_shot = self.successor_after_delete(paths, shot)
        staged = paths.deleted_dir / f"{token}-{shot.name}"
        try:
            remove_thumbnail_cache(paths, shot)
            shutil.move(str(shot), str(staged))
        except OSError as error:
            self.toast(f"Could not remove screenshot: {error}")
            return

        self.pending_deletes[token] = PendingDelete(staged, shot, profile_name)
        GLib.timeout_add_seconds(DELETE_FINALIZE_DELAY_SECONDS, self.finalize_delete, token)

        toast = Adw.Toast.new("Screenshot removed")
        toast.set_button_label("Undo")
        toast.set_action_name("win.undo-delete")
        toast.set_action_target_value(GLib.Variant("s", token))
        toast.set_timeout(DELETE_UNDO_TOAST_SECONDS)
        self.toast_overlay.add_toast(toast)

        self.selected_shot = next_shot
        self.invalidate_current_shots(profile_name)
        self.refresh_after_media_change(profile_name)
        if self.selected_profile == profile_name:
            self.select_visible_shot(next_shot)

    def on_undo_delete(self, _action: Gio.SimpleAction, parameter: GLib.Variant) -> None:
        token = parameter.get_string()
        pending = self.pending_deletes.pop(token, None)
        if pending is None:
            self.toast("That screenshot can no longer be restored.")
            return

        restore_path = pending.original_path
        if restore_path.exists():
            restore_path = restore_path.with_name(f"restored-{restore_path.name}")

        try:
            shutil.move(str(pending.staged_path), str(restore_path))
        except OSError as error:
            self.toast(f"Could not restore screenshot: {error}")
            return

        self.selected_shot = restore_path
        self.invalidate_current_shots(pending.profile_name)
        self.refresh_after_media_change(pending.profile_name)
        self.toast("Screenshot restored.")

    def finalize_delete(self, token: str) -> bool:
        pending = self.pending_deletes.pop(token, None)
        if pending and pending.staged_path.exists():
            pending.staged_path.unlink(missing_ok=True)
        return False

    def cleanup_old_staged_deletes(self) -> None:
        cutoff = time.time() - STAGED_DELETE_RETENTION_SECONDS
        deleted_roots = (DATA_DIR / "profiles").glob("*/.lapser3-deleted")
        for deleted_root in deleted_roots:
            if not deleted_root.is_dir():
                continue
            for path in deleted_root.iterdir():
                try:
                    if path.is_file() and path.stat().st_mtime < cutoff:
                        path.unlink()
                except OSError:
                    pass

