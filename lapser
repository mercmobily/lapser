@dataclass(frozen=True)
class DependencyStatus:
    missing_screen: tuple[str, ...]
    missing_window: tuple[str, ...]
    missing_conversion: tuple[str, ...]
    missing_thumbnail: tuple[str, ...]

    @property
    def screen_capture_available(self) -> bool:
        return not self.missing_screen

    @property
    def window_capture_available(self) -> bool:
        return not self.missing_window

    @property
    def conversion_available(self) -> bool:
        return not self.missing_conversion

    @property
    def thumbnail_generation_available(self) -> bool:
        return not self.missing_thumbnail

    @property
    def has_missing(self) -> bool:
        return bool(self.missing_tools())

    def missing_tools(self) -> list[str]:
        missing = (
            *self.missing_screen,
            *self.missing_window,
            *self.missing_conversion,
            *self.missing_thumbnail,
        )
        return sorted(dict.fromkeys(missing))

    def disabled_features(self) -> list[str]:
        features = []
        if not self.screen_capture_available:
            features.append("screen capture")
        if not self.window_capture_available:
            features.append("window capture")
        if not self.conversion_available:
            features.append("video conversion")
        if not self.thumbnail_generation_available:
            features.append("thumbnail previews")
        return features

    def install_targets_for(self, missing: Sequence[str]) -> list[str]:
        install = []
        for item in missing:
            if item.startswith("gstreamer "):
                install.append(f"{item} plugin")
            else:
                install.append(INSTALL_TARGETS.get(item, item))
        return sorted(dict.fromkeys(install))

    def install_targets(self) -> list[str]:
        return self.install_targets_for(self.missing_tools())

    def summary(self) -> str:
        if not self.has_missing:
            return ""
        return (
            f"Missing: {', '.join(self.missing_tools())}. "
            f"Install: {', '.join(self.install_targets())}. "
            f"Disabled: {', '.join(self.disabled_features())}."
        )


