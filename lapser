    def refresh_after_video_lifecycle_change(self, profile_name: str) -> None:
        self.invalidate_video_lifecycle(profile_name)
        self.refresh_after_media_change(profile_name)

    def confirm_discard_video(
        self,
        _button: Gtk.Button,
        profile_name: str,
        video_name: str,
    ) -> None:
        dialog = Adw.MessageDialog.new(
            self,
            "Discard video?",
            (
                f"Move {display_lapser_name(video_name)} to Discarded? "
                "The video and its log will be preserved, but its time will no "
                "longer be included in the project total. You can undo this later."
            ),
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("discard", "Discard Video")
        dialog.set_close_response("cancel")
        dialog.set_default_response("cancel")
        dialog.set_response_appearance("discard", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect(
            "response",
            self.on_discard_video_response,
            profile_name,
            video_name,
        )
        dialog.present()

    def on_discard_video_response(
        self,
        _dialog: Adw.MessageDialog,
        response: str,
        profile_name: str,
        video_name: str,
    ) -> None:
        if response == "discard":
            self.discard_video(profile_name, video_name)

    def discard_video(self, profile_name: str, video_name: str) -> None:
        paths = ProfilePaths.for_name(profile_name)
        paths.ensure()
        try:
            move_video_pair(
                paths.movies_not_uploaded_dir,
                paths.movies_discarded_dir,
                video_name,
                exists_message="Video already exists in Discarded.",
                log_exists_message="Video log already exists in Discarded.",
            )
        except CaptureError as error:
            self.toast(f"Could not discard video: {error}")
            return

        self.toast(f"Discarded, not deleted: {display_lapser_name(video_name)}")
        self.refresh_after_video_lifecycle_change(profile_name)

    def restore_discarded_video(
        self,
        _button: Gtk.Button,
        profile_name: str,
        video_name: str,
    ) -> None:
        paths = ProfilePaths.for_name(profile_name)
        paths.ensure()
        try:
            move_video_pair(
                paths.movies_discarded_dir,
                paths.movies_not_uploaded_dir,
                video_name,
                missing_message="Discarded video is missing.",
                exists_message="Video already exists in Videos Not Uploaded.",
                log_exists_message=(
                    "Video log already exists in Videos Not Uploaded."
                ),
            )
        except CaptureError as error:
            self.toast(f"Could not undo discard: {error}")
            return

        self.toast(f"Restored: {display_lapser_name(video_name)}")
        self.refresh_after_video_lifecycle_change(profile_name)

    def on_mark_uploaded(self, _button: Gtk.Button, profile_name: str, video_name: str) -> None:
        paths = ProfilePaths.for_name(profile_name)
        try:
            move_video_pair(
                paths.movies_not_uploaded_dir,
                paths.movies_uploaded_dir,
                video_name,
                exists_message="Uploaded video already exists.",
                log_exists_message="Uploaded video log already exists.",
            )
        except CaptureError as error:
            self.toast(f"Could not mark uploaded: {error}")
            return

        self.toast(f"Marked uploaded: {display_lapser_name(video_name)}")
        self.refresh_after_video_lifecycle_change(profile_name)

    def confirm_unmark_uploaded(
        self,
        _button: Gtk.Button,
        profile_name: str,
        video_name: str,
    ) -> None:
        dialog = Adw.MessageDialog.new(
            self,
            "Move video back?",
            (
                f"Move {display_lapser_name(video_name)} back to "
                "Videos Not Uploaded?"
            ),
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("move-back", "Move Back")
        dialog.set_close_response("cancel")
        dialog.set_default_response("cancel")
        dialog.set_response_appearance("move-back", Adw.ResponseAppearance.SUGGESTED)
        dialog.connect("response", self.on_unmark_uploaded_response, profile_name, video_name)
        dialog.present()

    def on_unmark_uploaded_response(
        self,
        _dialog: Adw.MessageDialog,
        response: str,
        profile_name: str,
        video_name: str,
    ) -> None:
        if response == "move-back":
            self.unmark_uploaded(profile_name, video_name)

    def unmark_uploaded(self, profile_name: str, video_name: str) -> None:
        paths = ProfilePaths.for_name(profile_name)
        try:
            move_video_pair(
                paths.movies_uploaded_dir,
                paths.movies_not_uploaded_dir,
                video_name,
                missing_message="Uploaded video is missing.",
                exists_message="Video already exists in Videos Not Uploaded.",
                log_exists_message="Video log already exists in Videos Not Uploaded.",
            )
        except CaptureError as error:
            self.toast(f"Could not move video back: {error}")
            return

        self.toast(f"Moved back: {display_lapser_name(video_name)}")
        self.refresh_after_video_lifecycle_change(profile_name)

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: TOASTS AND SHUTDOWN
    # Description: Surface transient messages and release running jobs, conversion
    #              processes, status timers, and video windows during close.
    # ==========================================================================

    def toast(self, text: str) -> None:
        self.toast_overlay.add_toast(Adw.Toast.new(text))

    def close(self) -> bool:
        for profile_name in list(self.jobs):
            self.stop_job(profile_name)
        for profile_name in list(self.converting_profiles):
            self.cancel_conversion(profile_name)
        for window in list(self.video_windows):
            window.close()
        if self.status_timer_id:
            GLib.source_remove(self.status_timer_id)
        return False


# ==============================================================================
# ==============================================================================
# SECTION: APPLICATION ENTRY POINT
# DESCRIPTION: Application object, startup CSS installation, activation, and
#              main() command dispatch.
# ==============================================================================
# ==============================================================================


class Lapser3Application(Adw.Application):
    def __init__(self, dependencies: DependencyStatus) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.dependencies = dependencies
        self.window: Lapser3Window | None = None

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def do_activate(self) -> None:
        if self.window is None:
            self.window = Lapser3Window(self, self.dependencies)
            self.window.connect("close-request", lambda window: window.close())
        self.window.present()


def main(argv: list[str]) -> int:
    if "--check-deps" in argv:
        return run_check_deps()

    dependencies = check_dependencies()
    if dependencies.has_missing:
        print(dependencies.summary(), file=sys.stderr)

    app = Lapser3Application(dependencies)
    return app.run(argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
