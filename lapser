@dataclass(frozen=True)
class ProfilePaths:
    name: str
    profile_dir: Path
    label_file: Path
    already_billed_file: Path
    config_file: Path
    log_file: Path
    shots_current_dir: Path
    shots_not_converted_dir: Path
    shots_converted_dir: Path
    movies_not_uploaded_dir: Path
    movies_uploaded_dir: Path
    movies_discarded_dir: Path
    deleted_dir: Path
    thumbnail_dir: Path

    @classmethod
    def for_name(cls, name: str) -> "ProfilePaths":
        profile_dir = DATA_DIR / "profiles" / name
        return cls(
            name=name,
            profile_dir=profile_dir,
            label_file=profile_dir / "working_on.txt",
            already_billed_file=profile_dir / "already_billed.txt",
            config_file=profile_dir / "config.cfg",
            log_file=profile_dir / "log.txt",
            shots_current_dir=profile_dir / "current_shots",
            shots_not_converted_dir=profile_dir / "shots_archived_not_converted",
            shots_converted_dir=profile_dir / "shots_archived_converted",
            movies_not_uploaded_dir=profile_dir / "movies_not_uploaded",
            movies_uploaded_dir=profile_dir / "movies_uploaded",
            movies_discarded_dir=profile_dir / "movies_discarded",
            deleted_dir=profile_dir / ".lapser3-deleted",
            thumbnail_dir=profile_dir / ".lapser3-thumbnails",
        )

    def ensure(self) -> None:
        ensure_base_dirs()
        for directory in (
            self.profile_dir,
            self.shots_current_dir,
            self.shots_not_converted_dir,
            self.shots_converted_dir,
            self.movies_not_uploaded_dir,
            self.movies_uploaded_dir,
            self.movies_discarded_dir,
            self.deleted_dir,
            self.thumbnail_dir,
        ):
            directory.mkdir(parents=True, exist_ok=True)

        for file_path in (
            self.label_file,
            self.already_billed_file,
            self.log_file,
            self.config_file,
        ):
            file_path.touch(exist_ok=True)


