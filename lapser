    def select_first_profile(self) -> None:
        if self.selected_profile and self.selected_profile in self.profile_rows:
            self.profile_list.select_row(self.profile_rows[self.selected_profile])
            return

        first = self.profile_list.get_row_at_index(0)
        if first is not None:
            self.profile_list.select_row(first)

    def on_profile_selected(self, _list_box: Gtk.ListBox, row: Gtk.ListBoxRow | None) -> None:
        if row is None:
            return
        self.selected_profile = row.profile_name
        self.selected_shot = None
        self.current_converted_set = None
        if self.lifecycle_stack.get_visible_child_name() == PAGE_CONVERTED_DETAIL:
            self.lifecycle_stack.set_visible_child_name(PAGE_CONVERTED)
        self.thumbnail_limits.setdefault(row.profile_name, THUMBNAIL_BATCH_SIZE)
        if self.suppress_profile_refresh:
            return
        self.refresh_profile_view(force_media=True)

    def selected_paths(self) -> ProfilePaths | None:
        if self.selected_profile is None:
            return None
        paths = ProfilePaths.for_name(self.selected_profile)
        paths.ensure()
        return paths

    def refresh_all(self) -> None:
        current = self.selected_profile
        self.load_profiles()
        if current and current in self.profile_rows:
            self.selected_profile = current
            self.profile_list.select_row(self.profile_rows[current])
        else:
            self.select_first_profile()
        self.refresh_profile_view(force_media=True)

    def refresh_profile_rows(self) -> None:
        current = self.selected_profile
        self.load_profiles()
        if current and current in self.profile_rows:
            self.selected_profile = current
            self.profile_list.select_row(self.profile_rows[current])

    def invalidate_thumbnail_context(self, context_key: str) -> None:
        self.thumbnail_signatures.pop(context_key, None)

    def invalidate_current_shots(self, profile_name: str) -> None:
        self.invalidate_thumbnail_context(profile_name)

    def invalidate_video_lifecycle(self, profile_name: str) -> None:
        self.converted_signatures.pop(profile_name, None)
        self.pending_video_signatures.pop(profile_name, None)
        self.uploaded_video_signatures.pop(profile_name, None)
        self.discarded_video_signatures.pop(profile_name, None)

    def refresh_after_media_change(
        self,
        profile_name: str,
        force_media: bool = True,
    ) -> None:
        self.refresh_profile_rows()
        if self.selected_profile == profile_name:
            self.refresh_profile_view(force_media=force_media)

    def refresh_profile_view(self, force_media: bool = False) -> None:
        paths = self.selected_paths()
        if paths is None:
            return

        self.profile_title.set_label(paths.name)
        self.current_folder_button.set_tooltip_text(
            f"Open current screenshots folder for {paths.name}"
        )
        self.working_entry.handler_block_by_func(self.on_working_changed)
        self.working_entry.set_text(read_text_file(paths.label_file))
        self.working_entry.handler_unblock_by_func(self.on_working_changed)
        self.already_billed_entry.handler_block_by_func(self.on_already_billed_changed)
        self.already_billed_entry.set_text(read_text_file(paths.already_billed_file))
        self.already_billed_entry.handler_unblock_by_func(self.on_already_billed_changed)

        shots = current_shot_files(paths)
        converted = converted_dirs(paths)
        pending_videos = video_files(paths.movies_not_uploaded_dir)
        uploaded_videos = video_files(paths.movies_uploaded_dir)
        discarded_videos = video_files(paths.movies_discarded_dir)
        self.refresh_status_controls(paths, len(shots))

        shot_signature = shot_list_signature(shots)
        thumbnail_limit = self.thumbnail_limits.get(paths.name, THUMBNAIL_BATCH_SIZE)
        thumbnail_signature = (shot_signature, thumbnail_limit)
        converted_signature = self.converted_signature(paths, converted)
        pending_signature = file_signature(pending_videos)
        uploaded_signature = file_signature(uploaded_videos)
        discarded_signature = file_signature(discarded_videos)

        self.shot_count_label.set_label(f"{len(shots)} shots")
        if force_media or self.thumbnail_signatures.get(paths.name) != thumbnail_signature:
            self.thumbnail_signatures[paths.name] = thumbnail_signature
            self.refresh_thumbnails(paths, shots)
        if force_media or self.converted_signatures.get(paths.name) != converted_signature:
            self.converted_signatures[paths.name] = converted_signature
            self.refresh_converted_sets(paths, converted)
        if self.lifecycle_stack.get_visible_child_name() == PAGE_CONVERTED_DETAIL:
            if (
                self.current_converted_set is None
                or self.current_converted_set.parent != paths.shots_converted_dir
                or not self.current_converted_set.exists()
            ):
                self.current_converted_set = None
                self.lifecycle_stack.set_visible_child_name(PAGE_CONVERTED)
            else:
                self.refresh_converted_detail(paths, self.current_converted_set)
        if force_media or self.pending_video_signatures.get(paths.name) != pending_signature:
            self.pending_video_signatures[paths.name] = pending_signature
            self.refresh_video_list(paths, pending_videos, state="pending")
        if force_media or self.uploaded_video_signatures.get(paths.name) != uploaded_signature:
            self.uploaded_video_signatures[paths.name] = uploaded_signature
            self.refresh_video_list(paths, uploaded_videos, state="uploaded")
        if (
            force_media
            or self.discarded_video_signatures.get(paths.name) != discarded_signature
        ):
            self.discarded_video_signatures[paths.name] = discarded_signature
            self.refresh_video_list(paths, discarded_videos, state="discarded")
        self.refresh_work_summary(
            paths,
            shots,
            converted,
            [*pending_videos, *uploaded_videos],
            discarded_videos,
        )

    def refresh_status_controls(self, paths: ProfilePaths, shot_count: int) -> None:
        job = self.jobs.get(paths.name)

        converting = paths.name in self.converting_profiles

        if converting:
            progress = self.conversion_progress.get(paths.name, 0.0)
            self.status_pill.set_label("Converting")
            self.status_pill.remove_css_class("quiet-pill")
            self.status_pill.add_css_class("status-pill")
            if paths.name in self.cancelled_conversions:
                if paths.name in self.manual_video_profiles:
                    self.profile_subtitle.set_label("Cancelling manual video")
                else:
                    self.profile_subtitle.set_label("Cancelling conversion")
            elif paths.name in self.manual_video_profiles:
                self.profile_subtitle.set_label(
                    f"Creating manual video ({int(progress * 100)}%)"
                )
            else:
                self.profile_subtitle.set_label(f"Creating movie ({int(progress * 100)}%)")
        elif job:
            self.status_pill.set_label(f"Recording {job.mode}")
            self.status_pill.remove_css_class("quiet-pill")
            self.status_pill.add_css_class("status-pill")
            if job.busy:
                self.profile_subtitle.set_label("Capturing now")
            else:
                self.profile_subtitle.set_label(f"Next shot in {job.seconds_until_next()}s")
        else:
            self.status_pill.set_label("Idle")
            self.status_pill.remove_css_class("status-pill")
            self.status_pill.add_css_class("quiet-pill")
            self.profile_subtitle.set_label("Ready to capture")

        self.stop_button.set_sensitive(job is not None)
        self.start_screen_button.set_sensitive(
            job is None and not converting and self.dependencies.screen_capture_available
        )
        self.start_screen_button.set_tooltip_text(
            self.unavailable_tooltip(
                self.dependencies.missing_screen,
                "Start full-screen capture for this profile",
            )
        )
        self.start_window_button.set_sensitive(
            job is None and not converting and self.dependencies.window_capture_available
        )
        self.start_window_button.set_tooltip_text(
            self.unavailable_tooltip(
                self.dependencies.missing_window,
                "Start selected-window capture for this profile",
            )
        )
        self.convert_current_button.set_sensitive(
            shot_count >= MIN_SHOTS_TO_CONVERT
            and job is None
            and not converting
            and self.dependencies.conversion_available
        )
        self.convert_current_button.set_tooltip_text(
            self.unavailable_tooltip(
                self.dependencies.missing_conversion,
                "Create a movie from current screenshots",
            )
        )
        manual_missing = tuple(
            sorted(
                dict.fromkeys(
                    (
                        *self.dependencies.missing_conversion,
                        *self.dependencies.missing_thumbnail,
                    )
                )
            )
        )
        self.manual_video_button.set_sensitive(
            job is None and not converting and not manual_missing
        )
        self.manual_video_button.set_tooltip_text(
            self.unavailable_tooltip(
                manual_missing,
                "Create a video for work completed without screen capture",
            )
        )
        self.refresh_conversion_progress(paths)

    def refresh_conversion_progress(self, paths: ProfilePaths) -> None:
        if paths.name not in self.converting_profiles:
            self.conversion_box.set_visible(False)
            return

        progress = clamp(self.conversion_progress.get(paths.name, 0.0))
        cancelling = paths.name in self.cancelled_conversions
        manual_video = paths.name in self.manual_video_profiles
        self.conversion_box.set_visible(True)
        if cancelling:
            label = "Cancelling..."
        elif manual_video:
            label = "Creating manual video"
        else:
            label = "Converting video"
        self.conversion_label.set_label(label)
        self.conversion_progress_bar.set_fraction(progress)
        self.conversion_progress_bar.set_text(f"{int(progress * 100)}%")
        self.cancel_conversion_button.set_sensitive(not cancelling)
        self.cancel_conversion_button.set_tooltip_text(
            "Cancel manual video" if manual_video else "Cancel conversion"
        )

    def cached_video_duration(self, video_path: Path) -> float | None:
        key = video_duration_cache_key(video_path)
        if key is None:
            return None
        if key not in self.video_duration_cache:
            self.video_duration_cache[key] = probe_video_duration(video_path)
        return self.video_duration_cache[key]

    def calculate_work_summary(
        self,
        paths: ProfilePaths,
        current_shots: list[Path],
        converted_sets: list[Path],
        videos: list[Path],
        excluded_videos: list[Path] | None = None,
    ) -> WorkSummary:
        unique_videos: dict[str, Path] = {}
        for video in videos:
            unique_videos.setdefault(video.name, video)

        converted_by_name = {converted_set.name: converted_set for converted_set in converted_sets}
        handled_converted_sets = {
            video.stem for video in (excluded_videos or [])
        }
        video_output_seconds = 0.0
        video_work_seconds = 0.0
        unreadable_video_count = 0
        unaccounted_video_count = 0
        screenshot_count = sum(
            1 for shot in current_shots if shot.suffix.lower() == JPG_SUFFIX
        )
        screenshot_count += recursive_jpg_count(paths.shots_not_converted_dir)

        for video in unique_videos.values():
            converted_set = converted_by_name.get(video.stem)
            duration = self.cached_video_duration(video)
            if duration is not None:
                video_output_seconds += duration
                video_work_seconds += (
                    duration * VIDEO_FRAMERATE * CAPTURE_INTERVAL_SECONDS
                )
                if converted_set is not None:
                    handled_converted_sets.add(converted_set.name)
                continue

            unreadable_video_count += 1
            if converted_set is None:
                unaccounted_video_count += 1
                continue
            screenshot_count += len(jpg_files(converted_set))
            handled_converted_sets.add(converted_set.name)

        for converted_set in converted_sets:
            if converted_set.name not in handled_converted_sets:
                screenshot_count += len(jpg_files(converted_set))

        screenshot_work_seconds = screenshot_count * CAPTURE_INTERVAL_SECONDS
        return WorkSummary(
            video_count=len(unique_videos),
            video_output_seconds=video_output_seconds,
            video_work_seconds=video_work_seconds,
            screenshot_count=screenshot_count,
            screenshot_work_seconds=screenshot_work_seconds,
            unreadable_video_count=unreadable_video_count,
            unaccounted_video_count=unaccounted_video_count,
        )

    def refresh_work_summary(
        self,
        paths: ProfilePaths,
        current_shots: list[Path],
        converted_sets: list[Path],
        videos: list[Path],
        excluded_videos: list[Path] | None = None,
    ) -> None:
        summary = self.calculate_work_summary(
            paths,
            current_shots,
            converted_sets,
            videos,
            excluded_videos,
        )
        self.work_summaries[paths.name] = summary
        self.update_billing_labels(summary)

    def update_billing_labels(self, summary: WorkSummary) -> None:
        total_text = format_duration(summary.total_work_seconds)
        if summary.unaccounted_video_count:
            total_text += "+"
        self.total_worked_label.set_label(total_text)

        video_word = "video" if summary.video_count == 1 else "videos"
        shot_word = "screenshot" if summary.screenshot_count == 1 else "screenshots"
        details = (
            f"{summary.video_count} {video_word}: "
            f"{format_duration(summary.video_output_seconds, zero_unit='s')} of timelapse "
            f"= {format_duration(summary.video_work_seconds)} worked. "
            f"{summary.screenshot_count} other {shot_word} x "
            f"{CAPTURE_INTERVAL_SECONDS}s = "
            f"{format_duration(summary.screenshot_work_seconds)} worked."
        )
        if summary.unreadable_video_count:
            details += (
                f" {summary.unreadable_video_count} video duration(s) could not be read; "
                "matching screenshot archives were used when available."
            )
        if summary.unaccounted_video_count:
            details += (
                f" {summary.unaccounted_video_count} unreadable video(s) had no matching "
                "screenshot archive and are not included."
            )
        self.total_worked_label.set_tooltip_text(details)

        raw_billed = self.already_billed_entry.get_text()
        billed_seconds = parse_billed_duration(raw_billed)
        self.already_billed_entry.remove_css_class("error")
        self.already_billed_entry.set_tooltip_text(
            "Enter hours as 2h 30m, 2:30, 150m, or 2.5. Saved for this profile."
        )
        if billed_seconds is None:
            self.already_billed_entry.add_css_class("error")
            self.already_billed_entry.set_tooltip_text(
                "Could not read this time. Try 2h 30m, 2:30, 150m, or 2.5."
            )
            self.to_bill_label.set_label("Check time")
            self.to_bill_label.set_tooltip_text("The already billed time is not valid.")
            return

        remaining_seconds = summary.total_work_seconds - billed_seconds
        if remaining_seconds >= 0:
            self.to_bill_label.set_label(format_duration(remaining_seconds))
            self.to_bill_label.set_tooltip_text(
                f"{format_duration(summary.total_work_seconds)} total minus "
                f"{format_duration(billed_seconds)} already billed."
            )
        else:
            credit_seconds = abs(remaining_seconds)
            self.to_bill_label.set_label(f"0m · {format_duration(credit_seconds)} ahead")
            self.to_bill_label.set_tooltip_text(
                f"Already billed exceeds tracked work by {format_duration(credit_seconds)}."
            )

    # ==========================================================================
    # MAIN WINDOW SUBSECTION: THUMBNAIL GRID AND LAZY LOADING
    # Description: Render current/converted screenshot grids, queue thumbnail
    #              generation, preserve scroll position, and load older batches.
    # ==========================================================================

    def converted_signature(self, paths: ProfilePaths, sets: list[Path]) -> MediaSignature:
        set_keys: list[SignatureEntry] = []
        for converted_set in sets:
            try:
                jpg_count = len(jpg_files(converted_set))
                set_keys.append((converted_set.name, converted_set.stat().st_mtime_ns, jpg_count))
            except FileNotFoundError:
                continue
        return tuple(set_keys)

    def refresh_thumbnails(self, paths: ProfilePaths, shots: list[Path]) -> None:
        limit = self.thumbnail_limits.get(paths.name, THUMBNAIL_BATCH_SIZE)
        self.populate_shot_flow(
            self.thumb_flow,
            paths,
            shots,
            paths.name,
            limit,
            allow_delete=True,
            load_older_profile=paths.name,
        )

    def populate_shot_flow(
        self,
        flow: Gtk.FlowBox,
        paths: ProfilePaths,
        shots: list[Path],
        context_key: str,
        limit: int,
        allow_delete: bool,
        load_older_profile: str | None = None,
    ) -> None:
        clear_container(flow)
        self.thumbnail_pictures = {
            key: picture
            for key, picture in self.thumbnail_pictures.items()
            if key[0] != context_key
        }

        if not self.dependencies.thumbnail_generation_available:
            flow.append(self.make_thumbnails_unavailable_child())
            return

        newest_first = list(reversed(shots))
        visible_shots = newest_first[:limit]

        for shot in visible_shots:
            child = Gtk.FlowBoxChild()
            child.shot_path = shot
            child.set_tooltip_text(shot.name)
            self.add_file_drag_source(child, shot)

            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            card.add_css_class("thumb-card")
            card.set_tooltip_text(shot.name)
            child.set_child(card)

            overlay = Gtk.Overlay()
            card.append(overlay)

            picture = Gtk.Picture()
            picture.set_content_fit(Gtk.ContentFit.COVER)
            picture.set_can_shrink(True)
            picture.set_size_request(THUMB_WIDTH, THUMB_HEIGHT)
            overlay.set_child(picture)

            key = shot_cache_key(shot)
            if key is not None:
                widget_key = thumbnail_widget_key(context_key, key)
                self.thumbnail_pictures[widget_key] = picture
                cached = thumbnail_path(paths, shot, key)
                if cached.exists():
                    picture.set_filename(str(cached))
                else:
                    self.queue_thumbnail(paths, shot, key, context_key)

            if allow_delete:
                delete_button = icon_button(
                    "user-trash-symbolic",
                    f"Remove {shot.name}",
                    "thumb-delete",
                )
                delete_button.add_css_class("circular")
                delete_button.add_css_class("destructive-action")
                delete_button.set_halign(Gtk.Align.END)
                delete_button.set_valign(Gtk.Align.START)
                delete_button.connect("clicked", self.on_delete_clicked, paths.name, shot)
                overlay.add_overlay(delete_button)

            label = Gtk.Label(label=display_lapser_name(shot.name))
            label.add_css_class("muted")
            label.set_tooltip_text(shot.name)
            label.set_max_width_chars(20)
            label.set_ellipsize(3)
            card.append(label)

            flow.append(child)

        hidden_count = len(shots) - len(visible_shots)
        if hidden_count > 0 and load_older_profile is not None:
            flow.append(self.make_load_older_child(load_older_profile, hidden_count))

    def make_thumbnails_unavailable_child(self) -> Gtk.FlowBoxChild:
        child = Gtk.FlowBoxChild()
        child.shot_path = None
        child.set_can_focus(False)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("thumb-card")
        card.set_size_request(THUMB_WIDTH * 2, THUMB_HEIGHT)
        child.set_child(card)

        title = Gtk.Label(label="Thumbnail previews unavailable")
        title.add_css_class("section-heading")
        title.set_halign(Gtk.Align.START)
        card.append(title)

        install = ", ".join(
            self.dependencies.install_targets_for(self.dependencies.missing_thumbnail)
        )
        detail = Gtk.Label(label=f"Install {install}.")
        detail.add_css_class("muted")
        detail.set_halign(Gtk.Align.START)
        detail.set_wrap(True)
        card.append(detail)
        return child

    def make_load_older_child(self, limit_key: str, hidden_count: int) -> Gtk.FlowBoxChild:
        child = Gtk.FlowBoxChild()
        child.shot_path = None
        child.load_older_key = limit_key
        child.set_can_focus(False)

        button = Gtk.Button()
        button.add_css_class("flat")
        button.add_css_class("thumb-card")
        button.set_tooltip_text("Show older screenshots")
        button.set_size_request(THUMB_WIDTH, THUMB_HEIGHT)
        button.connect("clicked", self.on_load_older_clicked, limit_key, hidden_count)
        child.set_child(button)

        self.set_load_older_button_content(
            button,
            hidden_count,
            loading=limit_key in self.loading_more_keys,
        )
        return child

    def set_load_older_button_content(
        self,
        button: Gtk.Button,
        hidden_count: int,
        loading: bool,
    ) -> None:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content.set_halign(Gtk.Align.CENTER)
        content.set_valign(Gtk.Align.CENTER)
        content.set_size_request(THUMB_WIDTH, THUMB_HEIGHT)

        if loading:
            spinner = Gtk.Spinner()
            spinner.start()
            content.append(spinner)

            title = Gtk.Label(label="Loading...")
            title.add_css_class("section-heading")
            content.append(title)
        else:
            icon = Gtk.Image.new_from_icon_name("view-more-symbolic")
            icon.set_pixel_size(24)
            content.append(icon)

            title = Gtk.Label(label="Load Older")
            title.add_css_class("section-heading")
            content.append(title)

        label = Gtk.Label(label=f"{hidden_count} hidden")
        label.add_css_class("muted")
        content.append(label)
        button.set_child(content)

    def on_load_older_clicked(
        self,
        button: Gtk.Button,
        limit_key: str,
        hidden_count: int,
    ) -> None:
        if limit_key in self.loading_more_keys:
            return

        scroller = self.scroller_for_thumbnail_limit(limit_key)
        scroll_value = scroller.get_vadjustment().get_value() if scroller is not None else None
        self.loading_more_keys.add(limit_key)
        button.set_sensitive(False)
        self.set_load_older_button_content(button, hidden_count, loading=True)
        GLib.timeout_add(
            LOAD_MORE_DELAY_MS,
            self.perform_load_older,
            limit_key,
            scroller,
            scroll_value,
        )

    def perform_load_older(
        self,
        limit_key: str,
        scroller: Gtk.ScrolledWindow | None,
        scroll_value: float | None,
    ) -> bool:
        self.thumbnail_limits[limit_key] = self.thumbnail_limits.get(
            limit_key,
            THUMBNAIL_BATCH_SIZE,
        ) + THUMBNAIL_BATCH_SIZE
        self.invalidate_thumbnail_context(limit_key)
        self.loading_more_keys.discard(limit_key)
        if self.selected_profile is not None:
            self.refresh_profile_view(force_media=True)
        if scroller is not None and scroll_value is not None:
            GLib.idle_add(self.restore_scroller_position, scroller, scroll_value, 2)
        return False

    def scroller_for_thumbnail_limit(self, limit_key: str) -> Gtk.ScrolledWindow | None:
        if limit_key == self.selected_profile:
            return self.thumb_scroller

        paths = self.selected_paths()
        if paths is None or self.current_converted_set is None:
            return None

        if limit_key == converted_context_key(paths.name, self.current_converted_set.name):
            return self.converted_detail_scroller
        return None

    def restore_scroller_position(
        self,
        scroller: Gtk.ScrolledWindow,
        value: float,
        retries: int,
    ) -> bool:
        adjustment = scroller.get_vadjustment()
        maximum = max(adjustment.get_lower(), adjustment.get_upper() - adjustment.get_page_size())
        adjustment.set_value(min(max(value, adjustment.get_lower()), maximum))
        if retries > 0:
            GLib.idle_add(self.restore_scroller_position, scroller, value, retries - 1)
        return False

    def queue_thumbnail(
        self,
        paths: ProfilePaths,
        shot: Path,
        key: ShotCacheKey,
        context_key: str,
    ) -> None:
        job_key = thumbnail_widget_key(context_key, key)
        if job_key in self.thumbnail_jobs:
            return

        self.thumbnail_jobs.add(job_key)
        self.thumbnail_queue.put((context_key, paths.name, shot, key))
        if not self.thumbnail_worker_started:
            self.thumbnail_worker_started = True
            threading.Thread(
                target=self.thumbnail_worker,
                daemon=True,
            ).start()

    def thumbnail_worker(self) -> None:
        while True:
            context_key, profile_name, shot, key = self.thumbnail_queue.get()
            paths = ProfilePaths.for_name(profile_name)
            thumbnail: Path | None = None
            error: str | None = None
            try:
                if shot.exists():
                    thumbnail = create_thumbnail(paths, shot, key)
            except Exception as exc:
                error = str(exc)
            GLib.idle_add(self.thumbnail_ready, context_key, key, thumbnail, error)
            self.thumbnail_queue.task_done()

    def thumbnail_ready(
        self,
        context_key: str,
        key: ShotCacheKey,
        thumbnail: Path | None,
        error: str | None,
    ) -> bool:
        job_key = thumbnail_widget_key(context_key, key)
        self.thumbnail_jobs.discard(job_key)
        picture = self.thumbnail_pictures.get(job_key)
        if picture is not None and thumbnail is not None and thumbnail.exists():
            picture.set_filename(str(thumbnail))
        elif error:
            self.toast(f"Could not create thumbnail: {error}")
        return False

